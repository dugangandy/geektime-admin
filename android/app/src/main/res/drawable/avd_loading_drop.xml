<!-- 水滴加载动画：引用 ic_loading_drop，组合下落/淡出/涟漪三段 -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_loading_drop">
    <target android:name="drop" android:animation="@animator/loading_drop_fall" />
    <target android:name="drop" android:animation="@animator/loading_drop_fade" />
    <target android:name="ripple" android:animation="@animator/loading_ripple" />
</animated-vector>
