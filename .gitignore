# 仅把程序代码、模板、清单与测试纳入版本控制。
# 课程正文/音频/PDF/封面/官网存档等课程数据（约 56.5G）一律排除。
/*

# 仓库自身
!/.gitignore
!/README.md

# 根目录：服务端、首页生成器、启动脚本、测试
!/serve.py
!/site_generator.py
!/gen_html.py
!/mobile_api.py
!/serve.bat
!/serve-lan.bat
!/serve.command
!/package.json
!/test_autobuild.py
!/test_serve_auth.py
!/test_mobile_api.py

# 导航模板与 115 门权威清单
!/_导航模版/

# 离线阅读器模板
!/_阅读器模板/

# Android 客户端：只放行源码与构建脚本
!/android/
android/*
!/android/app/
android/app/*
!/android/app/src/
!/android/app/build.gradle.kts
!/android/build.gradle.kts
!/android/settings.gradle.kts
!/android/gradle.properties
!/android/version.properties
!/android/tools/

# 构建产物 / 缓存 / 日志 / 密钥 / 本地状态
__pycache__/
*.py[cod]
*.log
*.out
*.bak
*.tmp
.gradle/
.kotlin/
build/
*.apk
local.properties
auth.json
auth.log
login.yaml
